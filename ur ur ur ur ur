// main.ino or main.cpp
void setup() {
 pinMode(buzzerPin, OUTPUT);
}

void loop() {
 delay(1000); 

  // Chama a função tocando no pino configurado (6)
  playMidi(buzzerPin, midi1, ARRAY_LEN(midi1));

  // Espera 3 segundos em silêncio e começa tudo de novo
  delay(3000);
}
