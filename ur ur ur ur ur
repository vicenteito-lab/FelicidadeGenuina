void playMidi(int pin, const int notes[][3], size_t len){
  for (int i = 0; i < len; i++) {
    // Lê os valores da memória Flash
    int freq  = pgm_read_word(&(notes[i][0]));
    int dur   = pgm_read_word(&(notes[i][1]));
    int pause = pgm_read_word(&(notes[i][2]));

    // Se a frequência for maior que 0, toca a nota
    if (freq > 0) {
      tone(pin, freq);
    }
    delay(dur);
    noTone(pin);
    delay(pause);
  }
}
